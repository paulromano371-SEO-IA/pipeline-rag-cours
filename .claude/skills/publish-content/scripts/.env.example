# Copie ce fichier vers .env (dans ce meme dossier, non commite) et
# renseigne les valeurs. Utilise par publish_to_wordpress.py pour publier un
# article genere par /create-content vers WordPress (API REST wp-json).

# URL du site, sans slash final.
WP_URL=https://www.example.com

# Identifiant WordPress (le compte, pas l'email forcement).
WP_USER=

# Mot de passe d'application genere dans WP :
# Utilisateurs > Profil > Mots de passe d'application.
# Ce n'est PAS le mot de passe de connexion habituel.
WP_APP_PASSWORD=
